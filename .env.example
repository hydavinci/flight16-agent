# Explicit OpenAI-compatible Chat Completions endpoint with tool calling.
LLM_PROVIDER=openai-compatible
# Replace the model name with one actually served by your endpoint.
# Example only: a separate model service, not the flight-agent Web server.
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=your-tool-calling-model
# For local endpoints without authentication, use a nonempty placeholder.
LLM_API_KEY=local-placeholder
LLM_TIMEOUT_SECONDS=60

# Optional generic Web planning and diagnostic-review backend on macOS/Linux: copilot-cli.
# Requires a signed-in GitHub Copilot CLI with JSONL output and tool filtering.
# With this provider, BASE_URL/API_KEY are unused and MODEL may be omitted.

# Generic Web host: optional HTTP Worker for registered Simulink project capabilities.
# Local matlab_project and Agent-visible diagnostic_data do not require a Worker.
MATLAB_WORKER_URL=http://127.0.0.1:9001
# Generate a private random token (at least 32 ASCII characters); use the same on both hosts.
MATLAB_WORKER_TOKEN=

# Web host for local matlab_project; Worker host for its directory adapter.
# Initializers, model callbacks and native sources execute with service-account privileges.
# Deployment opt-in does not replace exact-baseline trusted-project confirmation.
MATLAB_ALLOW_TRUSTED_PROJECTS=0

# Optional existing Python with this project + MATLAB-release-compatible Engine installed.
# Used for BOTH local import probe and execution; unset uses the Web Python interpreter.
# Import availability does not establish startup/license availability. No auto-install.
# MATLAB_PYTHON_EXECUTABLE=/absolute/path/to/compatible/python
