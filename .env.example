# Explicit OpenAI-compatible Chat Completions endpoint with tool calling.
LLM_PROVIDER=openai-compatible
# Replace the model name with one actually served by your endpoint.
# Example only: a separate model service, not the flight-agent Web server.
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=your-tool-calling-model
# For local endpoints without authentication, use a nonempty placeholder.
LLM_API_KEY=local-placeholder
LLM_TIMEOUT_SECONDS=60

# Optional directory-workflow backend on macOS/Linux: copilot-cli.
# Requires a signed-in GitHub Copilot CLI with JSONL output and tool filtering.
# With this provider, BASE_URL/API_KEY are unused and MODEL may be omitted.
# CLI analyze and workbench Agent analysis still require openai-compatible.

# Web host: remote MATLAB worker via an SSH tunnel, or an approved HTTPS endpoint.
MATLAB_WORKER_URL=http://127.0.0.1:9001
# Generate a private random token (at least 32 ASCII characters); use the same on both hosts.
MATLAB_WORKER_TOKEN=

# Worker host only: opt in to executing uploaded code you have reviewed and trust.
# This is NOT a sandbox. Do not enable for untrusted uploaders or public access.
MATLAB_ALLOW_TRUSTED_UPLOADS=0

# Worker host only: allow confirmed, trusted directory projects in isolated copies.
# Initializers, model callbacks and native sources still execute with worker privileges.
MATLAB_ALLOW_TRUSTED_PROJECTS=0
